# Copy to .env (docker compose reads it automatically):  cp .env.example .env

# --- Images ----------------------------------------------------------------
# Leave empty to build the panel from source. To use the image published by scripts/publish-images.sh
# (docker login first):  docker compose pull panel && docker compose up -d --no-build
PANEL_IMAGE=
# Optional: Caddy from your own registry/mirror (default caddy:2-alpine)
CADDY_IMAGE=

# --- Which host IP/ports Caddy listens on --------------------------------
# 0.0.0.0 = all interfaces. Set a specific public/LAN IP of this server to bind only there
# (e.g. CADDY_BIND_IP=203.0.113.10). 127.0.0.1 = local only.
CADDY_BIND_IP=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Panel -----------------------------------------------------------------
# Keep 127.0.0.1 and expose the panel through a Caddy proxy host (HTTPS) instead.
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8181

# First-run admin: leave EMPTY to choose the admin in the browser (recommended). On first visit the setup page asks for
# the setup token printed in `docker compose logs panel` (or fix it here with SETUP_TOKEN). Set both ADMIN_* for an unattended install.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SETUP_TOKEN=

# Secure cookie is automatic when the panel is opened over HTTPS through Caddy; 1 forces it
SECURE_COOKIE=0

# --- CI / scripts API token ----------------------------------------------
# Optional static token (min 24 chars) for CI: `Authorization: Bearer <token>` on /api/hosts and
# /api/certificates only (create hosts, get Let's Encrypt certs). More tokens can be created in the UI.
# Generate one: openssl rand -hex 32
CERT_ASK_TOKEN=

# --- Docker management ---------------------------------------------------
# Host path of the Docker socket mounted into the panel (admin-only; root-equivalent access to the host!)
# Linux default below. Docker Desktop on Windows/macOS also works with the default.
DOCKER_SOCK_PATH=/var/run/docker.sock

# --- Monitoring ----------------------------------------------------------
# Filesystems to show used/free for: "path|Label,path|Label". Mounted file folders are added automatically.
MONITOR_DISKS=/|System

# --- File manager: up to 8 host folders ----------------------------------
# MOUNT_n_PATH = folder on the host (absolute path). Leave empty to disable the slot.
# MOUNT_n_NAME = label in the UI (default: folder name).   MOUNT_n_MODE = rw | ro (default ro)
# After changing these run: docker compose up -d
MOUNT_1_PATH=
MOUNT_1_NAME=
MOUNT_1_MODE=ro

MOUNT_2_PATH=
MOUNT_2_NAME=
MOUNT_2_MODE=ro

MOUNT_3_PATH=
MOUNT_3_NAME=
MOUNT_3_MODE=ro

MOUNT_4_PATH=
MOUNT_4_NAME=
MOUNT_4_MODE=ro

# Slots 5-8 work the same way: MOUNT_5_PATH ... MOUNT_8_MODE
